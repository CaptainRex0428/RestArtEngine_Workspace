# Private repository: explicit allowlist. Parent /local/ stays ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/workspace-manifest.json
!/docs/
/docs/*
!/docs/*.md
!/scripts/
/scripts/*
!/scripts/Sync-Workspace.ps1
!/scripts/Test-WorkspaceSync.ps1
!/workspace/
/workspace/*
!/workspace/.agents/
/workspace/.agents/*
!/workspace/.agents/skills/
!/workspace/.agents/skills/**
!/workspace/.codex/
/workspace/.codex/*
!/workspace/.codex/agents/
/workspace/.codex/agents/*
!/workspace/.codex/agents/*.toml

# Never version credentials, machine settings, caches or generated media.
.env
.env.*
*.local.*
auth.json
config.toml
credentials*
*.pem
*.key
__pycache__/
*.pyc
*.tmp
*.log
*.png
*.jpg
*.gif
*.bmp
*.mp4
*.psd
/.sync/
/machine/
/maintenance/
/scratch/
/assets/
